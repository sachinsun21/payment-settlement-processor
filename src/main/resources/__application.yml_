spring:
  application:
    name: LloydsPaymentFortress

  h2:
    console:
      enabled: true

  datasource:
    url: jdbc:h2:mem:consumer
    username: test
    password: test
    hikari:
      driver-class-name: org.h2.Driver
  threads:
    virtual:
      enabled: true
  jpa:
    database:
      platform: org.hibernate.dialect.H2Dialect
      hibernate:
        ddl-auto: update # Forces Hibernate to create the table
      show-sql: true
      properties:
        hibernate:
          dialect: org.hibernate.dialect.PostgreSQLDialect
  kafka:
    bootstrap-servers: localhost:9092
    producer:
      acks: all
      properties:
        enable.idempotence: true
    consumer:
      group-id: payment-processor-service
      auto-offset-reset: earliest
      enable-auto-commit: false # Crucial for Manual Acks
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      # Using the specific Jackson Deserializer
      value-deserializer: org.springframework.kafka.support.serializer.JacksonJsonDeserializer
      properties:
        # Replace with your ACTUAL package name for the Record
        spring.json.trusted.packages: "com.example.offer.dto"
        spring.json.value.default.type: "com.example.offer.dto.PaymentTransaction"

management:
  endpoints:
    web:
      exposure:
        include: health,metrics
  endpoint:
    health:
      show-details: always